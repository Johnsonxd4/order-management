{
  "realm": "ecommerce-platform",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Customer storefront access" },
      { "name": "catalog-manager", "description": "Catalog operations access" },
      { "name": "inventory-manager", "description": "Inventory operations access" },
      { "name": "order-manager", "description": "Order operations access" },
      { "name": "finance-analyst", "description": "Finance and payment analytics access" },
      { "name": "platform-admin", "description": "Full administration access" }
    ]
  },
  "clients": [
    {
      "clientId": "customer-web",
      "name": "Customer Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "operations-web",
      "name": "Operations Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3002/*"
      ],
      "webOrigins": [
        "http://localhost:3002"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "admin-web",
      "name": "Admin Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3003/*"
      ],
      "webOrigins": [
        "http://localhost:3003"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
